# Diagnostics and saves backup journey through the real pnr-launcher binary,
# with its own library directory (PNR_LIBRARY_DB). Disk checked after each step.
set(WS ${CMAKE_CURRENT_BINARY_DIR}/care_ws)
file(REMOVE_RECURSE ${WS})
file(MAKE_DIRECTORY ${WS})
set(ENV{PNR_LIBRARY_DB} ${WS}/lib/library.db)

function(run_launcher out_var rc_var)
  execute_process(COMMAND ${LAUNCHER} ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(${out_var} "${out}${err}" PARENT_SCOPE)
  set(${rc_var} ${rc} PARENT_SCOPE)
endfunction()

foreach(v 1.0.0 2.0.0)
  execute_process(COMMAND ${MAKE} ${WS}/g${v}.pnrgame care-game "Care Game" ${v} bin/game bin/game=${PS_DEMO}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "make_package failed: ${out} ${err}")
  endif()
endforeach()
run_launcher(out rc import ${WS}/g1.0.0.pnrgame)
run_launcher(out rc import ${WS}/g2.0.0.pnrgame)
if(NOT rc EQUAL 0 OR NOT out MATCHES "replaces v1.0.0")
  message(FATAL_ERROR "upgrade import wrong: ${rc} ${out}")
endif()

run_launcher(out rc doctor)
if(NOT rc EQUAL 0 OR NOT out MATCHES "ORPHAN INSTALL  games/care-game-1.0.0" OR NOT out MATCHES "read-only")
  message(FATAL_ERROR "doctor did not find the old version tree: ${rc} ${out}")
endif()
if(NOT EXISTS ${WS}/lib/games/care-game-1.0.0)
  message(FATAL_ERROR "doctor deleted something")
endif()

run_launcher(out rc clean)
if(NOT rc EQUAL 64)
  message(FATAL_ERROR "clean without --orphans should be a usage error, got ${rc}")
endif()
run_launcher(out rc clean --orphans)
if(NOT rc EQUAL 3 OR NOT out MATCHES "add --yes" OR NOT EXISTS ${WS}/lib/games/care-game-1.0.0)
  message(FATAL_ERROR "clean dry run wrong: ${rc} ${out}")
endif()
run_launcher(out rc clean --orphans --yes)
if(NOT rc EQUAL 0 OR EXISTS ${WS}/lib/games/care-game-1.0.0 OR NOT EXISTS ${WS}/lib/games/care-game-2.0.0/bin/game)
  message(FATAL_ERROR "clean wrong: ${rc} ${out}")
endif()
run_launcher(out rc launch care-game)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "game no longer launches after clean: ${out}")
endif()

# saves: the demo wrote psdemo_proof.txt into its jail
set(SAVE ${WS}/lib/jail/care-game/psdemo_proof.txt)
if(NOT EXISTS ${SAVE})
  message(FATAL_ERROR "expected a saves file from the launch")
endif()
file(READ ${SAVE} original)
run_launcher(out rc export care-game ${WS}/saves.tar)
if(NOT rc EQUAL 0 OR NOT out MATCHES "EXPORT OK: 1 file" OR NOT EXISTS ${WS}/saves.tar)
  message(FATAL_ERROR "export failed: ${rc} ${out}")
endif()
run_launcher(out rc export care-game ${WS}/saves.tar)
if(rc EQUAL 0 OR NOT out MATCHES "overwrite")
  message(FATAL_ERROR "export overwrote an existing file: ${out}")
endif()
file(WRITE ${SAVE} "CHANGED")
run_launcher(out rc restore-saves care-game ${WS}/saves.tar)
file(READ ${SAVE} now)
if(NOT rc EQUAL 0 OR NOT out MATCHES "left alone" OR NOT now STREQUAL "CHANGED")
  message(FATAL_ERROR "restore without --overwrite changed a file: ${out}")
endif()
run_launcher(out rc restore-saves care-game ${WS}/saves.tar --overwrite)
file(READ ${SAVE} now)
if(NOT rc EQUAL 0 OR NOT now STREQUAL original)
  message(FATAL_ERROR "restore --overwrite did not restore: ${out}")
endif()
# an archive with an unsafe name is refused and writes nothing
file(WRITE ${WS}/garbage.tar "not a tar")
run_launcher(out rc restore-saves care-game ${WS}/garbage.tar --overwrite)
if(rc EQUAL 0 OR NOT out MATCHES "REFUSED")
  message(FATAL_ERROR "garbage archive was not refused: ${out}")
endif()
run_launcher(out rc restore-saves no-such-game ${WS}/saves.tar)
if(rc EQUAL 0)
  message(FATAL_ERROR "restore into an unknown game was not refused")
endif()
# kept saves show up as orphan saves and survive clean
run_launcher(out rc remove care-game --keep-saves --yes)
run_launcher(out rc clean --orphans --yes)
run_launcher(out rc doctor)
if(NOT out MATCHES "ORPHAN SAVES  jail/care-game" OR NOT EXISTS ${SAVE})
  message(FATAL_ERROR "kept saves were not reported or did not survive clean: ${out}")
endif()
message(STATUS "launcher care workflow OK")
