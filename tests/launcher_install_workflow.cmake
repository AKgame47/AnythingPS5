# Launcher install journey with its own library directory (PNR_LIBRARY_DB):
# import -> verify -> launch -> dry-run remove -> remove --keep-saves ->
# reinstall -> remove -> refusals. Disk state is checked after every step.
set(WS ${CMAKE_CURRENT_BINARY_DIR}/inst_ws)
file(REMOVE_RECURSE ${WS})
file(MAKE_DIRECTORY ${WS})
set(ENV{PNR_LIBRARY_DB} ${WS}/lib/library.db)

function(run_launcher out_var rc_var)
  execute_process(COMMAND ${LAUNCHER} ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(${out_var} "${out}${err}" PARENT_SCOPE)
  set(${rc_var} ${rc} PARENT_SCOPE)
endfunction()

execute_process(COMMAND ${MAKE} ${WS}/wf.pnrgame wf-game "Workflow Game" 1.0.0 bin/game bin/game=${PS_DEMO}
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "make_package failed: ${out} ${err}")
endif()

run_launcher(out rc import ${WS}/wf.pnrgame)
if(NOT rc EQUAL 0 OR NOT out MATCHES "IMPORT OK: wf-game" OR NOT out MATCHES "new install")
  message(FATAL_ERROR "import failed: ${rc} ${out}")
endif()
if(NOT EXISTS ${WS}/lib/games/wf-game-1.0.0/bin/game)
  message(FATAL_ERROR "install tree not under the launcher's library directory")
endif()
run_launcher(out rc verify wf-game)
if(NOT rc EQUAL 0 OR NOT out MATCHES "VERIFY OK")
  message(FATAL_ERROR "verify failed: ${out}")
endif()
run_launcher(out rc launch wf-game)
if(NOT rc EQUAL 0 OR NOT EXISTS ${WS}/lib/jail/wf-game/psdemo_proof.txt)
  message(FATAL_ERROR "launch failed or jail proof file missing: ${out}")
endif()

# dry run deletes nothing
run_launcher(out rc remove wf-game)
if(NOT rc EQUAL 3 OR NOT out MATCHES "add --yes" OR NOT EXISTS ${WS}/lib/games/wf-game-1.0.0/bin/game)
  message(FATAL_ERROR "remove without --yes was not a dry run: ${rc} ${out}")
endif()
# keep-saves removal
run_launcher(out rc remove wf-game --keep-saves --yes)
if(NOT rc EQUAL 0 OR EXISTS ${WS}/lib/games/wf-game-1.0.0 OR NOT EXISTS ${WS}/lib/jail/wf-game/psdemo_proof.txt)
  message(FATAL_ERROR "remove --keep-saves wrong: ${rc} ${out}")
endif()
run_launcher(out rc list)
if(NOT out MATCHES "library is empty")
  message(FATAL_ERROR "library not empty after remove: ${out}")
endif()
# reinstall, then full removal including saves
run_launcher(out rc import ${WS}/wf.pnrgame)
run_launcher(out rc remove wf-game --yes)
if(NOT rc EQUAL 0 OR EXISTS ${WS}/lib/games/wf-game-1.0.0 OR EXISTS ${WS}/lib/jail/wf-game)
  message(FATAL_ERROR "full remove left files behind: ${rc} ${out}")
endif()
run_launcher(out rc remove wf-game --yes)
if(NOT rc EQUAL 2)
  message(FATAL_ERROR "second remove should exit 2, got ${rc}: ${out}")
endif()
foreach(bad .. . a/b ../lib)
  run_launcher(out rc remove ${bad} --yes)
  if(rc EQUAL 0 OR NOT EXISTS ${WS}/lib/library.db)
    message(FATAL_ERROR "hostile id ${bad} not refused: ${rc} ${out}")
  endif()
endforeach()
# corrupted package: refused, nothing installed
file(WRITE ${WS}/bad.pnrgame "this is not a pnrgame")
run_launcher(out rc import ${WS}/bad.pnrgame)
if(rc EQUAL 0 OR NOT out MATCHES "IMPORT REFUSED")
  message(FATAL_ERROR "bad package was not refused: ${out}")
endif()
run_launcher(out rc list)
if(NOT out MATCHES "library is empty")
  message(FATAL_ERROR "bad import changed the library: ${out}")
endif()
# deleted entry point: verify fails, game no longer runnable
run_launcher(out rc import ${WS}/wf.pnrgame)
file(REMOVE ${WS}/lib/games/wf-game-1.0.0/bin/game)
run_launcher(out rc verify wf-game)
if(rc EQUAL 0 OR NOT out MATCHES "VERIFY FAILED" OR NOT out MATCHES "marked failed")
  message(FATAL_ERROR "verify did not catch the deleted entry point: ${rc} ${out}")
endif()
run_launcher(out rc list)
if(NOT out MATCHES "not runnable")
  message(FATAL_ERROR "failed game still listed runnable: ${out}")
endif()
message(STATUS "launcher install workflow OK")
