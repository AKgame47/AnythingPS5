# PSN connector journey through the real pnr-launcher binary (offline).
# The response file is SYNTHETIC. The token is a dummy 64-char string.
set(WS ${CMAKE_CURRENT_BINARY_DIR}/psn_ws)
file(REMOVE_RECURSE ${WS})
file(MAKE_DIRECTORY ${WS})
set(ENV{PNR_LIBRARY_DB} ${WS}/lib/library.db)
unset(ENV{PNR_PSN_TOKEN_FILE})
set(TOK "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZab")

function(run_launcher out_var rc_var)
  execute_process(COMMAND ${LAUNCHER} ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(${out_var} "${out}${err}" PARENT_SCOPE)
  set(${rc_var} ${rc} PARENT_SCOPE)
endfunction()

file(WRITE ${WS}/resp.json "{\"data\":{\"purchasedTitlesRetrieve\":{\"__typename\":\"GameList\",\"games\":[
{\"entitlementId\":\"EP0001-DEMO_00-ALPHA\",\"titleId\":\"PPSA00001_00\",\"productId\":\"EP0001-PPSA00001_00-ALPHA\",\"conceptId\":\"1\",\"name\":\"Synthetic Alpha\",\"platform\":\"PS5\",\"membership\":\"NONE\",\"isActive\":true,\"isDownloadable\":true,\"isPreOrder\":false,\"image\":{\"url\":\"https://example.invalid/a.png\"}},
{\"entitlementId\":\"EP0001-DEMO_00-BETA\",\"titleId\":\"CUSA00002_00\",\"productId\":\"EP0001-CUSA00002_00-BETA\",\"conceptId\":null,\"name\":\"Synthetic Beta\",\"platform\":\"PS4\",\"membership\":\"PS_PLUS\",\"isActive\":true,\"isDownloadable\":false,\"isPreOrder\":false,\"image\":{\"url\":\"https://example.invalid/b.png\"}}
]}}}")
file(WRITE ${WS}/tok.txt "${TOK}\n")

run_launcher(out rc psn status)
if(NOT rc EQUAL 0 OR NOT out MATCHES "token: absent" OR NOT out MATCHES "only `psn sync` contacts Sony")
  message(FATAL_ERROR "status without token wrong: ${rc} ${out}")
endif()

# token from stdin, never argv
execute_process(COMMAND ${LAUNCHER} psn set-token INPUT_FILE ${WS}/tok.txt RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0 OR NOT out MATCHES "TOKEN STORED")
  message(FATAL_ERROR "set-token failed: ${rc} ${out} ${err}")
endif()
if(NOT EXISTS ${WS}/lib/psn/npsso.token)
  message(FATAL_ERROR "token file not at the expected place")
endif()
execute_process(COMMAND stat -c %a ${WS}/lib/psn/npsso.token OUTPUT_VARIABLE mode OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT mode STREQUAL "600")
  message(FATAL_ERROR "token file mode is ${mode}, expected 600")
endif()
execute_process(COMMAND ${LAUNCHER} psn set-token INPUT_FILE ${WS}/resp.json RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(rc EQUAL 0 OR NOT out MATCHES "token-format")
  message(FATAL_ERROR "garbage token should be refused: ${rc} ${out}")
endif()

run_launcher(out rc psn import-json ${WS}/resp.json --complete)
if(NOT rc EQUAL 0 OR NOT out MATCHES "PSN IMPORT OK" OR NOT out MATCHES "added 2")
  message(FATAL_ERROR "import failed: ${rc} ${out}")
endif()
run_launcher(out rc psn import-json ${WS}/resp.json --complete)
if(NOT rc EQUAL 0 OR NOT out MATCHES "unchanged 2")
  message(FATAL_ERROR "re-import not idempotent: ${rc} ${out}")
endif()

# owned entries are not installed games
run_launcher(out rc list)
if(out MATCHES "Synthetic")
  message(FATAL_ERROR "owned entries leaked into 'list': ${out}")
endif()
run_launcher(out rc psn owned)
if(NOT rc EQUAL 0 OR NOT out MATCHES "Synthetic Alpha" OR NOT out MATCHES "no PC build linked" OR NOT out MATCHES "no download feature")
  message(FATAL_ERROR "owned listing wrong: ${rc} ${out}")
endif()
run_launcher(out rc psn owned --platform ps4)
if(NOT out MATCHES "Synthetic Beta" OR out MATCHES "Synthetic Alpha")
  message(FATAL_ERROR "platform filter wrong: ${out}")
endif()
run_launcher(out rc psn owned --json)
if(NOT out MATCHES "\"installed\":false" OR NOT out MATCHES "\"runnable\":false")
  message(FATAL_ERROR "json must say not installed/not runnable: ${out}")
endif()

# a broken response changes nothing
file(WRITE ${WS}/broken.json "{\"data\":{\"somethingElse\":1}}")
run_launcher(out rc psn import-json ${WS}/broken.json --complete)
if(rc EQUAL 0 OR NOT out MATCHES "schema-change" OR NOT out MATCHES "nothing was imported")
  message(FATAL_ERROR "broken response not refused: ${rc} ${out}")
endif()
run_launcher(out rc psn status)
if(NOT out MATCHES "owned entries: 2 ")
  message(FATAL_ERROR "broken import changed the library: ${out}")
endif()

# loose permissions: status warns
execute_process(COMMAND chmod 644 ${WS}/lib/psn/npsso.token)
run_launcher(out rc psn status)
if(NOT out MATCHES "present-loose-permissions")
  message(FATAL_ERROR "loose permissions not reported: ${out}")
endif()
execute_process(COMMAND chmod 600 ${WS}/lib/psn/npsso.token)

# live sync: no token -> clear error and no change; with a token and no
# reachable Sony (this environment may have none) it must fail cleanly and
# change nothing. Real Sony behaviour is NOT tested here.
run_launcher(out rc psn sync)
if(rc EQUAL 0 OR NOT out MATCHES "token")
  message(FATAL_ERROR "sync with a token missing/invalid wrong: ${rc} ${out}")
endif()
if(out MATCHES "${TOK}")
  message(FATAL_ERROR "token echoed by sync")
endif()
run_launcher(out rc psn status)
if(NOT out MATCHES "owned entries: 2 ")
  message(FATAL_ERROR "failed sync changed the library: ${out}")
endif()

# disconnect
run_launcher(out rc psn disconnect --forget-owned)
if(NOT rc EQUAL 3 OR NOT EXISTS ${WS}/lib/psn/npsso.token)
  message(FATAL_ERROR "forget without --yes must be a dry run: ${rc} ${out}")
endif()
run_launcher(out rc psn disconnect)
if(NOT rc EQUAL 0 OR EXISTS ${WS}/lib/psn/npsso.token OR NOT out MATCHES "cannot revoke")
  message(FATAL_ERROR "disconnect wrong: ${rc} ${out}")
endif()
run_launcher(out rc psn status)
if(NOT out MATCHES "token: absent" OR NOT out MATCHES "owned entries: 2 ")
  message(FATAL_ERROR "after disconnect: ${out}")
endif()

# the token must not be anywhere under the workspace except tok.txt (our own input)
file(GLOB_RECURSE files LIST_DIRECTORIES false ${WS}/lib/*)
foreach(f ${files})
  file(READ ${f} content HEX)
  string(HEX "${TOK}" tokhex)
  if(content MATCHES "${tokhex}")
    message(FATAL_ERROR "token found in ${f}")
  endif()
endforeach()
message(STATUS "psn workflow ok")
