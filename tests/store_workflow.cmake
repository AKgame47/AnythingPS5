# Store install journey through the real pnr-launcher. The network step is
# replaced by hand-placing a cached index and a "downloaded" file in the
# store directory (no real source is contacted); everything after that,
# including the hash gate and the importer, is the real code path.
set(WS ${CMAKE_CURRENT_BINARY_DIR}/store_ws)
file(REMOVE_RECURSE ${WS})
file(MAKE_DIRECTORY ${WS}/store/index ${WS}/store/downloads/demo)
set(ENV{PNR_LIBRARY_DB} ${WS}/lib/library.db)
set(ENV{PNR_STORE_DIR} ${WS}/store)

function(run_launcher out_var rc_var)
  execute_process(COMMAND ${LAUNCHER} ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(${out_var} "${out}${err}" PARENT_SCOPE)
  set(${rc_var} ${rc} PARENT_SCOPE)
endfunction()

execute_process(COMMAND ${MAKE} ${WS}/good.pnrgame st-game "Store Game" 1.0.0 bin/game bin/game=${PS_DEMO}
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "make_package failed: ${out} ${err}")
endif()
file(SHA256 ${WS}/good.pnrgame GOODSHA)
file(SIZE ${WS}/good.pnrgame GOODSIZE)

file(WRITE ${WS}/store/sources.json "{\"sources\":[{\"id\":\"demo\",\"index_url\":\"https://games.example.invalid/index.json\",\"rights\":\"test fixture\"}]}\n")
function(pkg_json id kind sha size out_var)
  set(${out_var} "{\"id\":\"${id}\",\"name\":\"${id}\",\"version\":\"1.0.0\",\"license\":\"MIT\",\"kind\":\"${kind}\",\"size\":${size},\"sha256\":\"${sha}\",\"url\":\"https://games.example.invalid/${id}.pnrgame\"}" PARENT_SCOPE)
endfunction()
pkg_json(good pnr-package ${GOODSHA} ${GOODSIZE} P1)
pkg_json(tampered pnr-package ${GOODSHA} ${GOODSIZE} P2)
pkg_json(notdone pnr-package ${GOODSHA} ${GOODSIZE} P3)
pkg_json(foreign ps5-pkg ${GOODSHA} ${GOODSIZE} P4)
file(WRITE ${WS}/store/index/demo.json "{\"format\":\"pnr-store-index-1\",\"name\":\"Fixture\",\"rights\":\"test fixture\",\"packages\":[${P1},${P2},${P3},${P4}]}\n")
foreach(id good tampered foreign)
  file(WRITE ${WS}/store/downloads/demo/${id}.state "{\"status\":\"verified\",\"sha256\":\"${GOODSHA}\",\"etag\":\"\",\"error\":\"\"}\n")
endforeach()
file(WRITE ${WS}/store/downloads/demo/notdone.state "{\"status\":\"queued\",\"sha256\":\"${GOODSHA}\",\"etag\":\"\",\"error\":\"\"}\n")
file(COPY_FILE ${WS}/good.pnrgame ${WS}/store/downloads/demo/good.pnrgame)
file(COPY_FILE ${WS}/good.pnrgame ${WS}/store/downloads/demo/foreign.pnrgame)
file(COPY_FILE ${WS}/good.pnrgame ${WS}/store/downloads/demo/tampered.pnrgame)
file(APPEND ${WS}/store/downloads/demo/tampered.pnrgame "X")

run_launcher(out rc store search --source demo)
if(NOT rc EQUAL 0 OR NOT out MATCHES "\\[supported\\] demo/good" OR NOT out MATCHES "\\[unsupported\\] demo/foreign")
  message(FATAL_ERROR "search wrong: ${rc} ${out}")
endif()

# refusals leave the library empty
foreach(id tampered notdone foreign)
  run_launcher(out rc store install demo ${id})
  if(rc EQUAL 0)
    message(FATAL_ERROR "install of ${id} must be refused: ${out}")
  endif()
endforeach()
run_launcher(out rc list)
if(out MATCHES "st-game")
  message(FATAL_ERROR "a refused install left a game behind: ${out}")
endif()
run_launcher(out rc store install demo tampered)
if(NOT out MATCHES "no longer matches")
  message(FATAL_ERROR "tampered file reason missing: ${out}")
endif()
run_launcher(out rc store install demo foreign)
if(NOT out MATCHES "not a PNR package")
  message(FATAL_ERROR "foreign kind reason missing: ${out}")
endif()
run_launcher(out rc store install demo notdone)
if(NOT out MATCHES "no verified download")
  message(FATAL_ERROR "unverified reason missing: ${out}")
endif()

# the good one installs through the real importer
run_launcher(out rc store install demo good)
if(NOT rc EQUAL 0 OR NOT out MATCHES "IMPORT OK: st-game" OR NOT out MATCHES "installed from source 'demo'" OR NOT out MATCHES "${GOODSHA}")
  message(FATAL_ERROR "install failed: ${rc} ${out}")
endif()
if(NOT EXISTS ${WS}/lib/games/st-game-1.0.0/bin/game)
  message(FATAL_ERROR "installed payload missing")
endif()
# provenance record written for the launch-time signature re-check
file(READ ${WS}/store/provenance/st-game.prov PROV)
if(NOT PROV MATCHES "sha256=${GOODSHA}" OR NOT PROV MATCHES "source=demo")
  message(FATAL_ERROR "provenance record missing or wrong: ${PROV}")
endif()
run_launcher(out rc store queue list)
if(NOT out MATCHES "demo/good  installed")
  message(FATAL_ERROR "queue should show installed: ${out}")
endif()
run_launcher(out rc compat show st-game)
if(NOT out MATCHES "Untested")
  message(FATAL_ERROR "a store install must start Untested: ${out}")
endif()
run_launcher(out rc launch st-game)
if(out MATCHES "LAUNCH NOT STARTED")
  message(FATAL_ERROR "unsigned (hash-only) source must not block launch: ${out}")
endif()
message(STATUS "store workflow ok")
