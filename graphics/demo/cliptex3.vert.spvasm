; PNR hand-authored clip-space textured-array vertex shader (slice S27):
; gl_Position = position (already clip space, float4 at location 0).
; Passes colour (tint) and the vec3 uv+layer coordinate through. GPL-2.0.
               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint Vertex %main "main" %inPos %inCol %inUV %outCol %outUV %glpos
               OpDecorate %inPos Location 0
               OpDecorate %inCol Location 1
               OpDecorate %inUV Location 2
               OpDecorate %outCol Location 0
               OpDecorate %outUV Location 1
               OpDecorate %glpos BuiltIn Position
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
      %float = OpTypeFloat 32
         %v3 = OpTypeVector %float 3
         %v4 = OpTypeVector %float 4
       %pi3 = OpTypePointer Input %v3
       %pi4 = OpTypePointer Input %v4
       %po3 = OpTypePointer Output %v3
       %po4 = OpTypePointer Output %v4
      %inPos = OpVariable %pi4 Input
      %inCol = OpVariable %pi3 Input
       %inUV = OpVariable %pi3 Input
     %outCol = OpVariable %po3 Output
      %outUV = OpVariable %po3 Output
      %glpos = OpVariable %po4 Output
       %main = OpFunction %void None %fn
          %e = OpLabel
          %p = OpLoad %v4 %inPos
               OpStore %glpos %p
        %col = OpLoad %v3 %inCol
               OpStore %outCol %col
         %uv = OpLoad %v3 %inUV
               OpStore %outUV %uv
               OpReturn
               OpFunctionEnd
