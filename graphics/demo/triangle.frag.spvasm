; Original PNR demo fragment shader, GPL-2.0. Vulkan 1.0.
OpCapability Shader
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %main "main" %color
OpExecutionMode %main OriginUpperLeft
OpDecorate %color Location 0
%void = OpTypeVoid
%fun = OpTypeFunction %void
%float = OpTypeFloat 32
%v4 = OpTypeVector %float 4
%po = OpTypePointer Output %v4
%color = OpVariable %po Output
%zero = OpConstant %float 0
%one = OpConstant %float 1
%red = OpConstantComposite %v4 %one %zero %zero %one
%main = OpFunction %void None %fun
%entry = OpLabel
OpStore %color %red
OpReturn
OpFunctionEnd
