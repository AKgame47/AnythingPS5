; PNR hand-authored textured fragment shader: rgb = texture(set 0 binding 0, uv).rgb
; * colour, alpha 1. Filtering and addressing come from the sampler the host
; created (nearest/linear, repeat/clamp). No mipmaps, no LOD bias. GPL-2.0.
               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint Fragment %main "main" %inCol %inUV %outCol
               OpExecutionMode %main OriginUpperLeft
               OpDecorate %inCol Location 0
               OpDecorate %inUV Location 1
               OpDecorate %outCol Location 0
               OpDecorate %tex DescriptorSet 0
               OpDecorate %tex Binding 0
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
      %float = OpTypeFloat 32
         %v2 = OpTypeVector %float 2
         %v3 = OpTypeVector %float 3
         %v4 = OpTypeVector %float 4
         %f1 = OpConstant %float 1
        %img = OpTypeImage %float 2D 0 0 0 1 Unknown
        %smp = OpTypeSampledImage %img
       %pusm = OpTypePointer UniformConstant %smp
        %pi2 = OpTypePointer Input %v2
        %pi3 = OpTypePointer Input %v3
        %po4 = OpTypePointer Output %v4
        %tex = OpVariable %pusm UniformConstant
      %inCol = OpVariable %pi3 Input
       %inUV = OpVariable %pi2 Input
     %outCol = OpVariable %po4 Output
       %main = OpFunction %void None %fn
          %e = OpLabel
          %s = OpLoad %smp %tex
         %uv = OpLoad %v2 %inUV
          %t = OpImageSampleImplicitLod %v4 %s %uv
          %c = OpLoad %v3 %inCol
         %t0 = OpCompositeExtract %float %t 0
         %t1 = OpCompositeExtract %float %t 1
         %t2 = OpCompositeExtract %float %t 2
         %c0 = OpCompositeExtract %float %c 0
         %c1 = OpCompositeExtract %float %c 1
         %c2 = OpCompositeExtract %float %c 2
          %r = OpFMul %float %t0 %c0
          %g = OpFMul %float %t1 %c1
          %b = OpFMul %float %t2 %c2
        %out = OpCompositeConstruct %v4 %r %g %b %f1
               OpStore %outCol %out
               OpReturn
               OpFunctionEnd
