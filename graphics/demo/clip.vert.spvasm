; PNR hand-authored pass-through vertex shader: gl_Position = inPos (already
; clip-space xyzw, e.g. produced by a translated RDNA compute kernel). GPL-2.0.
               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint Vertex %main "main" %inPos %inCol %outCol %glpos
               OpDecorate %inPos Location 0
               OpDecorate %inCol Location 1
               OpDecorate %outCol Location 0
               OpDecorate %glpos BuiltIn Position
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
      %float = OpTypeFloat 32
         %v3 = OpTypeVector %float 3
         %v4 = OpTypeVector %float 4
        %pi3 = OpTypePointer Input %v3
        %pi4 = OpTypePointer Input %v4
        %po3 = OpTypePointer Output %v3
        %po4 = OpTypePointer Output %v4
      %inPos = OpVariable %pi4 Input
      %inCol = OpVariable %pi3 Input
     %outCol = OpVariable %po3 Output
      %glpos = OpVariable %po4 Output
       %main = OpFunction %void None %fn
          %e = OpLabel
          %p = OpLoad %v4 %inPos
               OpStore %glpos %p
          %c = OpLoad %v3 %inCol
               OpStore %outCol %c
               OpReturn
               OpFunctionEnd
