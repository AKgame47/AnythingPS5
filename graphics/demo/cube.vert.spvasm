; PNR hand-authored vertex shader: gl_Position = MVP * vec4(position, 1),
; MVP is a column-major mat4 pushed per frame; colour passes through. GPL-2.0.
               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint Vertex %main "main" %inPos %inCol %outCol %glpos
               OpDecorate %inPos Location 0
               OpDecorate %inCol Location 1
               OpDecorate %outCol Location 0
               OpDecorate %glpos BuiltIn Position
               OpMemberDecorate %PC 0 Offset 0
               OpMemberDecorate %PC 0 ColMajor
               OpMemberDecorate %PC 0 MatrixStride 16
               OpDecorate %PC Block
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
      %float = OpTypeFloat 32
         %v3 = OpTypeVector %float 3
         %v4 = OpTypeVector %float 4
         %m4 = OpTypeMatrix %v4 4
        %int = OpTypeInt 32 1
         %i0 = OpConstant %int 0
         %f1 = OpConstant %float 1
         %PC = OpTypeStruct %m4
       %pPC = OpTypePointer PushConstant %PC
         %pc = OpVariable %pPC PushConstant
       %pm4 = OpTypePointer PushConstant %m4
       %pi3 = OpTypePointer Input %v3
       %po3 = OpTypePointer Output %v3
       %po4 = OpTypePointer Output %v4
      %inPos = OpVariable %pi3 Input
      %inCol = OpVariable %pi3 Input
     %outCol = OpVariable %po3 Output
      %glpos = OpVariable %po4 Output
       %main = OpFunction %void None %fn
          %e = OpLabel
          %p = OpLoad %v3 %inPos
         %p0 = OpCompositeExtract %float %p 0
         %p1 = OpCompositeExtract %float %p 1
         %p2 = OpCompositeExtract %float %p 2
         %p4 = OpCompositeConstruct %v4 %p0 %p1 %p2 %f1
         %mp = OpAccessChain %pm4 %pc %i0
          %m = OpLoad %m4 %mp
        %pos = OpMatrixTimesVector %v4 %m %p4
               OpStore %glpos %pos
        %col = OpLoad %v3 %inCol
               OpStore %outCol %col
               OpReturn
               OpFunctionEnd
